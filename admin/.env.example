# ============================================================================
# VARDHMAN MILLS - ADMIN PANEL ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# Note: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# Never commit .env.local to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Vardhman Mills Admin
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ----------------------------------------------------------------------------
# API CONFIGURATION
# ----------------------------------------------------------------------------
# Backend API URL (must be accessible from browser)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:5000/api/admin
NEXT_PUBLIC_API_TIMEOUT=30000

# ----------------------------------------------------------------------------
# NEXTAUTH CONFIGURATION
# ----------------------------------------------------------------------------
# Generate secret: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-nextauth-secret-for-admin-panel-change-this-min-32-chars

# ----------------------------------------------------------------------------
# AUTHENTICATION
# ----------------------------------------------------------------------------
# Admin authentication endpoint
NEXT_PUBLIC_AUTH_ENDPOINT=/api/v1/auth/admin/login

# Session timeout (in milliseconds)
NEXT_PUBLIC_SESSION_TIMEOUT=3600000

# ----------------------------------------------------------------------------
# CLOUDINARY CONFIGURATION (Image Upload)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=admin-upload-preset
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-cloudinary-api-key

# ----------------------------------------------------------------------------
# ANALYTICS & MONITORING
# ----------------------------------------------------------------------------
# Google Analytics (Admin Dashboard)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
NEXT_PUBLIC_SENTRY_ENV=development

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------
# Enable/disable admin features
NEXT_PUBLIC_ENABLE_PRODUCT_IMPORT=true
NEXT_PUBLIC_ENABLE_BULK_OPERATIONS=true
NEXT_PUBLIC_ENABLE_ADVANCED_ANALYTICS=true
NEXT_PUBLIC_ENABLE_EMAIL_CAMPAIGNS=true
NEXT_PUBLIC_ENABLE_INVENTORY_MANAGEMENT=true
NEXT_PUBLIC_ENABLE_CUSTOMER_SEGMENTS=true
NEXT_PUBLIC_ENABLE_DISCOUNT_CAMPAIGNS=true
NEXT_PUBLIC_ENABLE_CONTENT_EDITOR=true

# ----------------------------------------------------------------------------
# FIREBASE CONFIGURATION (Push Notifications)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vardhman-mills-5942b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vardhman-mills-5942b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=vardhman-mills-5942b.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ----------------------------------------------------------------------------
# PAGINATION & DATA LIMITS
# ----------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
NEXT_PUBLIC_MAX_PAGE_SIZE=100
NEXT_PUBLIC_MAX_EXPORT_ROWS=10000

# ----------------------------------------------------------------------------
# FILE UPLOAD LIMITS
# ----------------------------------------------------------------------------
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_MAX_FILES=20
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/csv,application/vnd.ms-excel

# ----------------------------------------------------------------------------
# WEBSOCKET CONFIGURATION
# ----------------------------------------------------------------------------
# For real-time updates (orders, notifications)
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:5000
NEXT_PUBLIC_ENABLE_REALTIME_UPDATES=true

# ----------------------------------------------------------------------------
# RICH TEXT EDITOR CONFIGURATION
# ----------------------------------------------------------------------------
# TinyMCE or similar editor API key
NEXT_PUBLIC_EDITOR_API_KEY=your-editor-api-key

# ----------------------------------------------------------------------------
# CHARTS & VISUALIZATION
# ----------------------------------------------------------------------------
# Chart.js or similar configuration
NEXT_PUBLIC_CHART_THEME=light
NEXT_PUBLIC_CHART_ANIMATION=true

# ----------------------------------------------------------------------------
# EMAIL CONFIGURATION (Server-side)
# ----------------------------------------------------------------------------
# SMTP settings for sending emails from admin panel
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@vardhmanmills.com
SMTP_PASS=your-email-password-or-app-password

# ----------------------------------------------------------------------------
# BACKUP CONFIGURATION
# ----------------------------------------------------------------------------
# Automatic backup settings
NEXT_PUBLIC_ENABLE_AUTO_BACKUP=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# ----------------------------------------------------------------------------
# IP whitelist for admin access (comma-separated)
ADMIN_IP_WHITELIST=

# Two-factor authentication
NEXT_PUBLIC_ENABLE_2FA=true

# Session security
NEXT_PUBLIC_ENABLE_SESSION_LOCK=true
NEXT_PUBLIC_AUTO_LOGOUT_TIME=1800000

# ----------------------------------------------------------------------------
# AUDIT LOG CONFIGURATION
# ----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_AUDIT_LOG=true
NEXT_PUBLIC_AUDIT_LOG_RETENTION=90

# ----------------------------------------------------------------------------
# NOTIFICATION CONFIGURATION
# ----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ADMIN_NOTIFICATIONS=true
NEXT_PUBLIC_NOTIFICATION_SOUND=true

# ----------------------------------------------------------------------------
# DEVELOPMENT TOOLS
# ----------------------------------------------------------------------------
# Enable React DevTools
NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# Enable debug mode
NEXT_PUBLIC_DEBUG=false

# Mock data for development
NEXT_PUBLIC_MOCK_DATA=false

# ----------------------------------------------------------------------------
# REDIS/CACHE CONFIGURATION (Server-side only)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS
# ----------------------------------------------------------------------------
# Shipping provider APIs
SHIPROCKET_API_KEY=your-shiprocket-api-key
DELHIVERY_API_KEY=your-delhivery-api-key

# SMS provider
SMS_API_KEY=your-sms-api-key

# WhatsApp Business API
WHATSAPP_API_KEY=your-whatsapp-business-api-key

# ----------------------------------------------------------------------------
# REPORTING CONFIGURATION
# ----------------------------------------------------------------------------
# Report generation settings
NEXT_PUBLIC_ENABLE_PDF_REPORTS=true
NEXT_PUBLIC_ENABLE_EXCEL_EXPORT=true
NEXT_PUBLIC_ENABLE_SCHEDULED_REPORTS=true

# ----------------------------------------------------------------------------
# MULTI-LANGUAGE SUPPORT
# ----------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_AVAILABLE_LOCALES=en-IN

# ----------------------------------------------------------------------------
# CDN CONFIGURATION
# ----------------------------------------------------------------------------
NEXT_PUBLIC_CDN_URL=https://cdn.vardhmanmills.com
NEXT_PUBLIC_IMAGES_DOMAIN=res.cloudinary.com

# ----------------------------------------------------------------------------
# BUILD CONFIGURATION
# ----------------------------------------------------------------------------
# Analyze bundle size
ANALYZE=false

# ----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ----------------------------------------------------------------------------
# Log level: error, warn, info, debug
NEXT_PUBLIC_LOG_LEVEL=info

# Enable request logging
NEXT_PUBLIC_LOG_API_REQUESTS=true

# ----------------------------------------------------------------------------
# PRODUCTION CHECKLIST
# ----------------------------------------------------------------------------
# Before deploying to production:
# ✅ Change NODE_ENV to 'production'
# ✅ Update all URLs to production domains
# ✅ Generate new NEXTAUTH_SECRET
# ✅ Restrict ADMIN_IP_WHITELIST to known IPs
# ✅ Enable NEXT_PUBLIC_ENABLE_2FA
# ✅ Set NEXT_PUBLIC_DEBUG to false
# ✅ Set NEXT_PUBLIC_ENABLE_DEVTOOLS to false
# ✅ Configure production analytics
# ✅ Set up automated backups
# ✅ Enable audit logging
# ✅ Test all security features
# ✅ Verify API rate limiting
# ✅ Set appropriate session timeouts
# ✅ Configure production error tracking
# ✅ Test disaster recovery procedures
# ============================================================================
