# ============================================================================
# VARDHMAN MILLS - FRONTEND ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# Note: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# Never commit .env.local to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Vardhman Mills
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# API CONFIGURATION
# ----------------------------------------------------------------------------
# Backend API URL (must be accessible from browser)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000

# ----------------------------------------------------------------------------
# NEXTAUTH CONFIGURATION
# ----------------------------------------------------------------------------
# Generate secret: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-this-in-production-min-32-chars

# ----------------------------------------------------------------------------
# OAUTH PROVIDERS (Social Login)
# ----------------------------------------------------------------------------
# Google OAuth
# Get from: https://console.developers.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth
# Get from: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ----------------------------------------------------------------------------
# PAYMENT GATEWAY CONFIGURATION
# ----------------------------------------------------------------------------
# Razorpay (exposed to browser - use publishable key only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# Stripe (exposed to browser - use publishable key only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxx

# ----------------------------------------------------------------------------
# CLOUDINARY CONFIGURATION (Image Upload from Frontend)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ----------------------------------------------------------------------------
# GOOGLE SERVICES
# ----------------------------------------------------------------------------
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Maps API (for address autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google reCAPTCHA (for form protection)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ----------------------------------------------------------------------------
# FIREBASE CONFIGURATION (Push Notifications from Frontend)
# ----------------------------------------------------------------------------
# Get from: Firebase Console > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vardhman-mills-5942b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vardhman-mills-5942b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=vardhman-mills-5942b.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key-for-push-notifications

# ----------------------------------------------------------------------------
# SOCIAL MEDIA & SHARING
# ----------------------------------------------------------------------------
# Facebook Pixel (for ads tracking)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your-facebook-pixel-id

# Facebook App ID (for social sharing)
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# Twitter/X (for social sharing)
NEXT_PUBLIC_TWITTER_SITE=@vardhmanmills

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------
# Enable/disable features without code changes
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=true
NEXT_PUBLIC_ENABLE_GUEST_CHECKOUT=true
NEXT_PUBLIC_ENABLE_WISHLIST=true
NEXT_PUBLIC_ENABLE_PRODUCT_COMPARISON=true
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_ENABLE_LIVE_CHAT=false
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# ----------------------------------------------------------------------------
# SEO CONFIGURATION
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=Vardhman Mills
NEXT_PUBLIC_SITE_DESCRIPTION=Premium textile manufacturing and e-commerce platform
NEXT_PUBLIC_SITE_KEYWORDS=textiles,fabrics,clothing,manufacturing,vardhman
NEXT_PUBLIC_DEFAULT_OG_IMAGE=https://vardhmanmills.com/og-image.jpg

# ----------------------------------------------------------------------------
# CDN CONFIGURATION
# ----------------------------------------------------------------------------
# If using a CDN for static assets
NEXT_PUBLIC_CDN_URL=https://cdn.vardhmanmills.com
NEXT_PUBLIC_IMAGES_DOMAIN=res.cloudinary.com

# ----------------------------------------------------------------------------
# WEBSOCKET CONFIGURATION
# ----------------------------------------------------------------------------
# For real-time features (notifications, live chat)
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:5000

# ----------------------------------------------------------------------------
# LOCALIZATION
# ----------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_AVAILABLE_LOCALES=en-IN,hi-IN,pa-IN

# ----------------------------------------------------------------------------
# CONTACT INFORMATION
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=support@vardhmanmills.com
NEXT_PUBLIC_SUPPORT_PHONE=+91-161-2345678
NEXT_PUBLIC_WHATSAPP_NUMBER=+919876543210

# ----------------------------------------------------------------------------
# ERROR TRACKING & MONITORING
# ----------------------------------------------------------------------------
# Sentry DSN (exposed to browser)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Environment for Sentry
NEXT_PUBLIC_SENTRY_ENV=development

# ----------------------------------------------------------------------------
# PERFORMANCE MONITORING
# ----------------------------------------------------------------------------
# Enable performance monitoring
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=false

# ----------------------------------------------------------------------------
# BUILD CONFIGURATION
# ----------------------------------------------------------------------------
# Analyze bundle size
ANALYZE=false

# ----------------------------------------------------------------------------
# DEVELOPMENT TOOLS
# ----------------------------------------------------------------------------
# Enable React DevTools
NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# Enable debug mode
NEXT_PUBLIC_DEBUG=false

# API mocking for development
NEXT_PUBLIC_MOCK_API=false

# ----------------------------------------------------------------------------
# REDIS/CACHE CONFIGURATION (Server-side only)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
# Client-side rate limiting
NEXT_PUBLIC_API_RATE_LIMIT=100

# ----------------------------------------------------------------------------
# PRODUCTION CHECKLIST
# ----------------------------------------------------------------------------
# Before deploying to production:
# ✅ Change NODE_ENV to 'production'
# ✅ Update NEXT_PUBLIC_APP_URL to production domain
# ✅ Update NEXT_PUBLIC_API_URL to production API
# ✅ Update NEXTAUTH_URL to production domain
# ✅ Generate new NEXTAUTH_SECRET
# ✅ Use production OAuth credentials
# ✅ Use production Razorpay/Stripe keys
# ✅ Use production Firebase config
# ✅ Set up proper Google Analytics
# ✅ Configure production CDN
# ✅ Set NEXT_PUBLIC_DEBUG to false
# ✅ Set NEXT_PUBLIC_ENABLE_DEVTOOLS to false
# ✅ Configure production Sentry DSN
# ✅ Verify all NEXT_PUBLIC_ variables are safe for browser
# ✅ Remove unused environment variables
# ✅ Test all features in production mode
# ============================================================================
