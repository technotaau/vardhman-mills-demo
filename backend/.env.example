# ============================================================================
# VARDHMAN MILLS - BACKEND ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# Example: mongodb+srv://admin:mypassword@cluster0.abc123.mongodb.net/vardhman-mills?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/vardhman-mills

# If using MongoDB Atlas with separate password variable
MONGODB_PASSWORD=

# ----------------------------------------------------------------------------
# JWT AUTHENTICATION
# ----------------------------------------------------------------------------
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# ----------------------------------------------------------------------------
# FRONTEND & ADMIN URLs
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ----------------------------------------------------------------------------
# CLOUDINARY CONFIGURATION (Image Storage)
# ----------------------------------------------------------------------------
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ----------------------------------------------------------------------------
# PAYMENT GATEWAY - RAZORPAY
# ----------------------------------------------------------------------------
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ----------------------------------------------------------------------------
# PAYMENT GATEWAY - STRIPE (Optional)
# ----------------------------------------------------------------------------
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# ----------------------------------------------------------------------------
# FIREBASE CONFIGURATION (Push Notifications - Optional)
# ----------------------------------------------------------------------------
# Get these from: https://console.firebase.google.com/
# Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=vardhman-mills-5942b
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Firebase-Private-Key-Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@vardhman-mills-5942b.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://vardhman-mills-5942b-default-rtdb.firebaseio.com

# ----------------------------------------------------------------------------
# EMAIL SERVICE CONFIGURATION
# ----------------------------------------------------------------------------
# For Gmail, enable "Less secure app access" or use App Password
# For other services, check their SMTP documentation
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password-or-app-password
EMAIL_FROM=noreply@vardhmanmills.com
EMAIL_FROM_NAME=Vardhman Mills

# ----------------------------------------------------------------------------
# SMS SERVICE CONFIGURATION (Optional)
# ----------------------------------------------------------------------------
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret
SMS_SENDER_ID=VARDHN

# ----------------------------------------------------------------------------
# OAUTH PROVIDERS (Social Login - Optional)
# ----------------------------------------------------------------------------
# Google OAuth
# Get from: https://console.developers.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Facebook OAuth
# Get from: https://developers.facebook.com/
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# ----------------------------------------------------------------------------
# REDIS CONFIGURATION (Caching - Optional)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# ----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# ----------------------------------------------------------------------------
# Rate limiting (requests per hour)
RATE_LIMIT_MAX_REQUESTS=100

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----------------------------------------------------------------------------
# LOGGING & MONITORING (Optional)
# ----------------------------------------------------------------------------
# Sentry DSN for error tracking
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Log level: error, warn, info, debug
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# FILE UPLOAD LIMITS
# ----------------------------------------------------------------------------
MAX_FILE_SIZE=10485760
MAX_FILES=10

# ----------------------------------------------------------------------------
# SESSION CONFIGURATION
# ----------------------------------------------------------------------------
SESSION_SECRET=your-session-secret-change-this-in-production

# ----------------------------------------------------------------------------
# ADMIN CREDENTIALS (For Initial Setup Only)
# ----------------------------------------------------------------------------
# These are used ONLY during database seeding
# Remove from production environments after setup
ADMIN_EMAIL=admin@vardhmanmills.com
ADMIN_PASSWORD=Admin@123!ChangeMe

# ----------------------------------------------------------------------------
# MISCELLANEOUS
# ----------------------------------------------------------------------------
# Encryption key for sensitive data
ENCRYPTION_KEY=your-32-character-encryption-key

# Webhook secret for third-party integrations
WEBHOOK_SECRET=your-webhook-secret

# API version
API_VERSION=v1

# Enable debug mode
DEBUG=false

# ----------------------------------------------------------------------------
# PRODUCTION CHECKLIST
# ----------------------------------------------------------------------------
# Before deploying to production:
# ✅ Change NODE_ENV to 'production'
# ✅ Generate strong JWT_SECRET (min 64 chars)
# ✅ Set secure ADMIN_PASSWORD
# ✅ Use production MongoDB URL
# ✅ Configure production FRONTEND_URL and ADMIN_URL
# ✅ Set up proper SSL certificates
# ✅ Enable HTTPS for all URLs
# ✅ Configure production Cloudinary account
# ✅ Use production Razorpay/Stripe keys
# ✅ Set up proper email service (not Gmail for production)
# ✅ Enable rate limiting (reduce MAX_REQUESTS)
# ✅ Set up Redis for caching
# ✅ Configure Sentry for error tracking
# ✅ Remove or secure debug endpoints
# ✅ Set LOG_LEVEL to 'warn' or 'error'
# ============================================================================
